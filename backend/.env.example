# KuzuWiki-OSINT Environment Configuration
# Copy this file to .env and fill in your API keys and settings

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model: Newest free Llama available
JEV_PRIMARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct:free

# Fallback models: Nemotron → Gemma 3 → Llama 3.3 → Flint
JEV_FALLBACK_MODELS=nvidia/nemotron-3-8b-32k-instruct:free,google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free,google/flint-8b:free

# NLI and Embedding models
JEV_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
JEV_EMBEDDING_MODEL=BAAI/bge-m3

# KùzuDB Configuration
KUZU_DB_PATH=/data/kuzudb
WIKI_VAULT_PATH=/data/wiki
RAW_VAULT_PATH=/data/raw_vault

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# SearXNG Configuration
SEARXNG_URL=http://localhost:8080

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000

# Docker Compose Environment
# Set to true if running inside Docker container
DOCKER_ENV=false
