# KuzuWiki-OSINT Environment Configuration
# Copy this file to .env and fill in your API keys and settings

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model: OpenRouter free model (Nemotron). Model ids go stale - verify with
#   curl https://openrouter.ai/api/v1/models | grep ':free'
JEV_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning:free

# Fallback models: Flint, Gemma4, Nemotron (all OpenRouter free)
JEV_FALLBACK_MODELS=recursive/flint-v1.0:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free

# NLI and Embedding models
JEV_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
JEV_EMBEDDING_MODEL=BAAI/bge-m3

# KùzuDB Configuration
KUZU_DB_PATH=/data/kuzudb/graph.kuzu
WIKI_VAULT_PATH=/data/wiki
RAW_VAULT_PATH=/data/raw_vault
QUARANTINE_PATH=/data/quarantine

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# SearXNG Configuration
SEARXNG_URL=http://localhost:8080

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000

# Docker Compose Environment
# Set to true if running inside Docker container
DOCKER_ENV=false
